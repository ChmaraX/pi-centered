{
  "name": "pi-centered",
  "version": "0.0.0",
  "private": true,
  "description": "Center Pi's chat in a readable column on wide terminals. Wide Mermaid diagrams still break out to full size.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "tui",
    "layout",
    "max-width",
    "mermaid"
  ],
  "license": "MIT",
  "author": "Adam Chmara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChmaraX/pi-centered.git"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "e2e": "PATH=\"$PWD/node_modules/.bin:$PATH\" ./e2e/run.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}
